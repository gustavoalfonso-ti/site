# LinkedIn Update Agent Configuration
# Configuração do Agente de Atualização do LinkedIn

# LinkedIn OAuth 2.0 Access Token
# Obtenha seu token em: https://www.linkedin.com/developers/
# Get your token at: https://www.linkedin.com/developers/
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Default post visibility (PUBLIC or CONNECTIONS)
# Visibilidade padrão das publicações (PUBLIC ou CONNECTIONS)
DEFAULT_VISIBILITY=PUBLIC
